FLASK_SECRET_KEY=replace-with-a-long-random-secret
DB_HOST=localhost
DB_USER=maisha
DB_PASSWORD=replace-me
DB_NAME=maisha_jobs
MAIL_SERVER=mail.cm.co.ke
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USE_SSL=false
MAIL_USERNAME=accounts@example.com
MAIL_PASSWORD=replace-me
MAIL_DEFAULT_SENDER=accounts@example.com
# Comma-separated email addresses. Only these addresses can sign in as admin.
